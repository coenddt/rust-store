  {
    "kind": "permission",
    "name": "perm-creator-schema",
    "model": "Doc",
    "schemas": [
      {
        "name": "Doc", "collection": "docs", "timestamps": false,
        "read": ["creator"], "write": ["creator"],
        "fields": {
          "title": { "type": "string" },
          "locked": { "type": "string", "write": ["admin"] },
          "note": { "type": "string", "write": ["guest"] },
          "meta": { "type": "object", "fields": { "a": { "type": "string" } } }
        },
        "relations": {
          "comments": { "model": "Comment", "type": "many", "localField": "_id", "foreignField": "docId", "read": ["admin"] },
          "reviewer": { "model": "User", "type": "one", "localField": "reviewerId", "foreignField": "_id" }
        }
      }
    ],
    "context": { "userId": "u1", "roles": ["user"] },
    "condition": { "title": "x" },
    "data": { "title": "a", "locked": "b", "note": "c", "meta.a": 1, "unknown.z": 2 },
    "expect": {
      "canRead": true,
      "canWrite": true,
      "shouldInjectOwner": true,
      "condition": { "$and": [{ "title": "x" }, { "createdBy": "u1" }] },
      "readableFields": ["locked", "meta", "note", "title"],
      "readableRelations": ["reviewer"],
      "writableFields": ["meta", "title"],
      "filteredData": { "title": "a", "meta.a": 1 }
    }
  },
