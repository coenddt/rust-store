        "fields": { "label": { "type": "string" } },
        "relations": {}
      }
    ],
    "gql": "Post{title}",
    "items": [
      {
        "_id": "p1", "title": "t",
        "comments": [{ "_id": "c1", "text": "a", "stars": 1 }],
        "author": { "_id": "u1", "name": "n" },
        "tags": [{ "_id": "t1", "label": "l" }]
      }
    ],
    "expect": {
      "relDeps": [
        { "name": "comments", "fields": ["text", "stars"] },
        { "name": "author", "fields": [] }
      ],
      "ast": {
        "model": "Post",
        "params": {},
        "fields": ["title"],
        "relations": {
          "comments": { "fields": ["text", "stars"], "relations": {}, "params": {} },
          "author": { "fields": [], "relations": {}, "params": {} }
        }
      },
      "injectInfo": { "relations": { "comments": "__all__", "author": "__all__" } },
      "stripped": [{ "_id": "p1", "title": "t", "tags": [{ "_id": "t1", "label": "l" }] }]
    }
  },
