          "tags": { "model": "Tag", "type": "many", "localField": "_id", "foreignField": "postId" }
        },
        "computes": {
          "score": { "type": "int", "asyncFn": true, "depends": ["comments{text, stars}", "author", "_id", "unknown"] }
        }
      },
      {
        "name": "Comment", "collection": "comments", "timestamps": false,
        "fields": { "text": { "type": "string" }, "stars": { "type": "int" } },
        "relations": {}
      },
      {
        "name": "User", "collection": "users", "timestamps": false,
        "fields": { "name": { "type": "string" } },
        "relations": {}
      },
