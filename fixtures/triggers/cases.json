{
  "schemas": [
    {
      "name": "Order", "idPrefix": "o",
      "fields": { "userId": {"type": "string"}, "productId": {"type": "string"},
                  "amount": {"type": "number"}, "status": {"type": "string"} },
      "triggers": {
        "insert": [
          { "name": "decStock", "into": "Product", "op": "update",
            "condition": { "_id": "{{root.productId}}" },
            "data": { "$inc": { "stock": -1 } } },
          { "name": "stockLog", "into": "StockLog", "op": "insert",
            "data": { "orderId": "{{root._id}}", "delta": -1, "at": "{{now}}" } }
        ],
        "update": [
          { "name": "onPaid", "onFields": ["status"],
            "when": { "eq": ["{{root.status}}", "paid"] },
            "fnRef": "grantPoints",
            "args": { "userId": "{{root.userId}}", "amount": "{{root.amount}}" } }
        ],
        "remove": [
          { "name": "cleanLogs", "into": "StockLog", "op": "remove",
            "condition": { "orderId": "{{before._id}}" } },
          { "name": "onRemoved", "fnRef": "onOrderRemoved",
            "args": { "id": "{{before._id}}", "amount": "{{before.amount}}" } }
        ],
        "schedule": [
          { "name": "expireLogs", "cron": "0 2 * * *", "into": "StockLog", "op": "remove",
            "condition": { "at": { "$lt": "{{now}}" } } },
          { "name": "dailyReport", "cron": "*/10 * * * *", "fnRef": "onDailyReport",
            "args": { "at": "{{now}}" } }
        ]
      }
    },
    { "name": "Product", "fields": { "stock": {"type": "number"} } },
    { "name": "StockLog", "fields": { "orderId": {"type": "string"}, "delta": {"type": "number"}, "at": {"type": "number"} } }
  ],
  "cases": [
    { "fn": "planInsert", "schema": "Order", "now": 1730000000000, "newId": "o_fix1",
      "input": { "userId": "u1", "productId": "p9", "amount": 1200, "status": "new" } },
    { "fn": "planUpdate", "schema": "Order", "now": 1730000000000,
      "condition": { "_id": "o_fix1" }, "input": { "status": "paid" },
      "found": true, "doc": { "_id": "o_fix1", "status": "new" } }
  ],
  "errCases": [
    { "err": "缺少 cron",
      "defn": { "name": "E1", "collection": "e1", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "fnRef": "f" } ] } } },
    { "err": "必须为 5 段",
      "defn": { "name": "E2", "collection": "e2", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "cron": "* * * *", "fnRef": "f" } ] } } },
    { "err": "超出范围",
      "defn": { "name": "E3", "collection": "e3", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "cron": "99 * * * *", "fnRef": "f" } ] } } },
    { "err": "非法字符",
      "defn": { "name": "E4", "collection": "e4", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "cron": "a * * * *", "fnRef": "f" } ] } } },
    { "err": "不支持",
      "defn": { "name": "E5", "collection": "e5", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "cron": "* * * * *", "fnRef": "f",
                                              "args": { "x": "{{root._id}}" } } ] } } },
    { "err": "不支持",
      "defn": { "name": "E6", "collection": "e6", "idPrefix": "e",
                "fields": { "a": { "type": "string" } },
                "triggers": { "schedule": [ { "cron": "* * * * *", "fnRef": "f",
                                              "when": { "x": "{{before.a}}" } } ] } } }
  ],
  "cronCases": [
    { "cron": "* * * * *",       "at": { "y": 2026, "mo": 1, "d": 1,  "h": 12, "mi": 34 }, "expect": true },
    { "cron": "0 2 * * *",       "at": { "y": 2026, "mo": 1, "d": 1,  "h": 2,  "mi": 0 },  "expect": true },
    { "cron": "0 2 * * *",       "at": { "y": 2026, "mo": 1, "d": 1,  "h": 2,  "mi": 1 },  "expect": false },
    { "cron": "*/15 * * * *",    "at": { "y": 2026, "mo": 1, "d": 1,  "h": 0,  "mi": 30 }, "expect": true },
    { "cron": "*/15 * * * *",    "at": { "y": 2026, "mo": 1, "d": 1,  "h": 0,  "mi": 20 }, "expect": false },
    { "cron": "1-30/10 * * * *", "at": { "y": 2026, "mo": 1, "d": 1,  "h": 8,  "mi": 11 }, "expect": true },
    { "cron": "1-30/10 * * * *", "at": { "y": 2026, "mo": 1, "d": 1,  "h": 8,  "mi": 12 }, "expect": false },
    { "cron": "0 9-18 * * 1-5",  "at": { "y": 2026, "mo": 1, "d": 1,  "h": 9,  "mi": 0 },  "expect": true },
    { "cron": "0 9-18 * * 1-5",  "at": { "y": 2026, "mo": 1, "d": 3,  "h": 9,  "mi": 0 },  "expect": false },
    { "cron": "30 4 1,15 * *",   "at": { "y": 2026, "mo": 1, "d": 15, "h": 4,  "mi": 30 }, "expect": true },
    { "cron": "30 4 1,15 * *",   "at": { "y": 2026, "mo": 1, "d": 15, "h": 4,  "mi": 31 }, "expect": false },
    { "cron": "0 0 * * 0",       "at": { "y": 2026, "mo": 1, "d": 4,  "h": 0,  "mi": 0 },  "expect": true },
    { "cron": "0 0 * * 7",       "at": { "y": 2026, "mo": 1, "d": 4,  "h": 0,  "mi": 0 },  "expect": true },
    { "cron": "0 0 1 * 1",       "at": { "y": 2026, "mo": 1, "d": 5,  "h": 0,  "mi": 0 },  "expect": true },
    { "cron": "5 3 * * 2",       "at": { "y": 2026, "mo": 1, "d": 6,  "h": 3,  "mi": 5 },  "expect": true }
  ]
}
