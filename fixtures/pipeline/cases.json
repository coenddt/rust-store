  {
    "name": "compute-lookup",
    "schemas": [
      {
        "name": "Shop", "collection": "shops", "timestamps": false,
        "fields": { "name": { "type": "string" } },
        "computes": {
          "orderCount": {
            "type": "int",
            "lookup": {
              "from": "orders",
              "let": { "sid": "$_id" },
              "pipeline": [{ "$match": { "$expr": { "$eq": ["$shopId", "$$sid"] } } }],
              "as": "_orders"
            },
            "addFields": { "$size": { "$ifNull": ["$_orders", []] } }
          },
          "label": { "type": "string", "lookup": { "$concat": ["$name", "!"] } }
        },
        "relations": {}
      }
    ],
    "gql": "Shop{name, orderCount, label}",
    "params": {},
    "context": null
  },
